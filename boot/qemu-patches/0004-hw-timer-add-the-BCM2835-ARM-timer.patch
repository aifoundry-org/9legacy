diff --git a/hw/timer/bcm2835_armtmr.c b/hw/timer/bcm2835_armtmr.c
new file mode 100644
index 0000000..9f42eae
--- /dev/null
+++ b/hw/timer/bcm2835_armtmr.c
@@ -0,0 +1,284 @@
+/*
+ * BCM2835 ARM timer emulation
+ *
+ * The timer of the ARM side of the BCM2835, BCM2836, BCM2837 and
+ * BCM2711, described in chapter 14 of the BCM2835 ARM Peripherals
+ * document: a down counter after the SP804, but with only one timer,
+ * a predivider, and a free running counter.  Both count the APB clock.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/timer/bcm2835_armtmr.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define R_LOAD          0x00
+#define R_VALUE         0x04
+#define R_CONTROL       0x08
+#define R_IRQCLR        0x0c
+#define R_RAWIRQ        0x10
+#define R_MASKIRQ       0x14
+#define R_RELOAD        0x18
+#define R_PREDIVIDER    0x1c
+#define R_FREECNT       0x20
+
+#define CTRL_32BIT      (1 << 1)
+#define CTRL_PRESCALE   (3 << 2)
+#define CTRL_IE         (1 << 5)
+#define CTRL_ENABLE     (1 << 7)
+#define CTRL_FRENABLE   (1 << 9)
+#define CTRL_FRSCALE    (0xff << 16)
+#define CTRL_MASK       (CTRL_32BIT | CTRL_PRESCALE | CTRL_IE | CTRL_ENABLE | \
+                         (1 << 8) | CTRL_FRENABLE | CTRL_FRSCALE)
+
+static uint32_t bcm2835_armtmr_mask(BCM2835ArmTimerState *s)
+{
+    return s->control & CTRL_32BIT ? 0xffffffff : 0xffff;
+}
+
+static void bcm2835_armtmr_update_irq(BCM2835ArmTimerState *s)
+{
+    qemu_set_irq(s->irq, s->raw && (s->control & CTRL_IE));
+}
+
+static void bcm2835_armtmr_tick(void *opaque)
+{
+    BCM2835ArmTimerState *s = opaque;
+
+    trace_bcm2835_armtmr_expired();
+    s->raw = 1;
+    bcm2835_armtmr_update_irq(s);
+}
+
+static uint64_t bcm2835_armtmr_frfreq(BCM2835ArmTimerState *s)
+{
+    return s->freq / (((s->control & CTRL_FRSCALE) >> 16) + 1);
+}
+
+static uint32_t bcm2835_armtmr_frcount(BCM2835ArmTimerState *s)
+{
+    int64_t ns;
+
+    if (!(s->control & CTRL_FRENABLE)) {
+        return s->fr_count;
+    }
+    ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->fr_ns;
+    return s->fr_count + muldiv64(ns, bcm2835_armtmr_frfreq(s),
+                                  NANOSECONDS_PER_SECOND);
+}
+
+/* must be called inside a ptimer transaction */
+static void bcm2835_armtmr_set_freq(BCM2835ArmTimerState *s)
+{
+    static const int prescale[] = { 1, 16, 256, 1 };
+    uint32_t freq;
+
+    freq = s->freq / (s->predivider + 1);
+    freq /= prescale[(s->control & CTRL_PRESCALE) >> 2];
+    ptimer_set_freq(s->timer, freq ? freq : 1);
+}
+
+static uint64_t bcm2835_armtmr_read(void *opaque, hwaddr offset,
+                                    unsigned size)
+{
+    BCM2835ArmTimerState *s = opaque;
+    uint64_t r = 0;
+
+    switch (offset) {
+    case R_LOAD:
+    case R_RELOAD:
+        r = s->load;
+        break;
+    case R_VALUE:
+        r = ptimer_get_count(s->timer);
+        break;
+    case R_CONTROL:
+        r = s->control;
+        break;
+    case R_IRQCLR:
+        r = 0x544d5241;     /* "ARMT", as on the hardware */
+        break;
+    case R_RAWIRQ:
+        r = s->raw;
+        break;
+    case R_MASKIRQ:
+        r = s->raw && (s->control & CTRL_IE);
+        break;
+    case R_PREDIVIDER:
+        r = s->predivider;
+        break;
+    case R_FREECNT:
+        r = bcm2835_armtmr_frcount(s);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+        break;
+    }
+    trace_bcm2835_armtmr_read(offset, r);
+    return r;
+}
+
+static void bcm2835_armtmr_write(void *opaque, hwaddr offset,
+                                 uint64_t value64, unsigned size)
+{
+    BCM2835ArmTimerState *s = opaque;
+    uint32_t value = value64;
+    uint32_t old;
+
+    trace_bcm2835_armtmr_write(offset, value);
+    switch (offset) {
+    case R_LOAD:
+    case R_RELOAD:
+        s->load = value;
+        ptimer_transaction_begin(s->timer);
+        ptimer_set_limit(s->timer, value & bcm2835_armtmr_mask(s),
+                         offset == R_LOAD);
+        ptimer_transaction_commit(s->timer);
+        break;
+    case R_CONTROL:
+        old = s->control;
+        if ((old ^ value) & (CTRL_FRENABLE | CTRL_FRSCALE)) {
+            s->fr_count = bcm2835_armtmr_frcount(s);
+            s->fr_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        s->control = value & CTRL_MASK;
+        ptimer_transaction_begin(s->timer);
+        bcm2835_armtmr_set_freq(s);
+        if ((old ^ value) & CTRL_32BIT) {
+            ptimer_set_limit(s->timer, s->load & bcm2835_armtmr_mask(s), 0);
+        }
+        if (s->control & CTRL_ENABLE) {
+            ptimer_run(s->timer, 0);
+        } else {
+            ptimer_stop(s->timer);
+        }
+        ptimer_transaction_commit(s->timer);
+        bcm2835_armtmr_update_irq(s);
+        break;
+    case R_IRQCLR:
+        s->raw = 0;
+        bcm2835_armtmr_update_irq(s);
+        break;
+    case R_PREDIVIDER:
+        s->predivider = value & 0x3ff;
+        ptimer_transaction_begin(s->timer);
+        bcm2835_armtmr_set_freq(s);
+        ptimer_transaction_commit(s->timer);
+        break;
+    case R_VALUE:
+    case R_RAWIRQ:
+    case R_MASKIRQ:
+    case R_FREECNT:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: read-only offset 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+        break;
+    }
+}
+
+static const MemoryRegionOps bcm2835_armtmr_ops = {
+    .read = bcm2835_armtmr_read,
+    .write = bcm2835_armtmr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void bcm2835_armtmr_reset(DeviceState *dev)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTMR(dev);
+
+    s->load = 0;
+    s->control = 0x003e0020;
+    s->predivider = 0x7d;
+    s->raw = 0;
+    s->fr_count = 0;
+    s->fr_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    ptimer_transaction_begin(s->timer);
+    ptimer_stop(s->timer);
+    ptimer_set_limit(s->timer, 0, 1);
+    bcm2835_armtmr_set_freq(s);
+    ptimer_transaction_commit(s->timer);
+    qemu_set_irq(s->irq, 0);
+}
+
+static void bcm2835_armtmr_realize(DeviceState *dev, Error **errp)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTMR(dev);
+
+    s->timer = ptimer_init(bcm2835_armtmr_tick, s,
+                           PTIMER_POLICY_WRAP_AFTER_ONE_PERIOD |
+                           PTIMER_POLICY_CONTINUOUS_TRIGGER |
+                           PTIMER_POLICY_NO_IMMEDIATE_TRIGGER |
+                           PTIMER_POLICY_NO_IMMEDIATE_RELOAD |
+                           PTIMER_POLICY_NO_COUNTER_ROUND_DOWN);
+}
+
+static void bcm2835_armtmr_init(Object *obj)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTMR(obj);
+
+    memory_region_init_io(&s->iomem, obj, &bcm2835_armtmr_ops, s,
+                          TYPE_BCM2835_ARMTMR, 0x40);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+}
+
+static const VMStateDescription bcm2835_armtmr_vmstate = {
+    .name = "bcm2835_armtmr",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_PTIMER(timer, BCM2835ArmTimerState),
+        VMSTATE_UINT32(load, BCM2835ArmTimerState),
+        VMSTATE_UINT32(control, BCM2835ArmTimerState),
+        VMSTATE_UINT32(predivider, BCM2835ArmTimerState),
+        VMSTATE_UINT32(raw, BCM2835ArmTimerState),
+        VMSTATE_UINT32(fr_count, BCM2835ArmTimerState),
+        VMSTATE_INT64(fr_ns, BCM2835ArmTimerState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const Property bcm2835_armtmr_properties[] = {
+    /* the APB clock: the core clock, 250 MHz on a Raspberry Pi */
+    DEFINE_PROP_UINT32("clock-frequency", BCM2835ArmTimerState, freq,
+                       250000000),
+};
+
+static void bcm2835_armtmr_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = bcm2835_armtmr_realize;
+    device_class_set_legacy_reset(dc, bcm2835_armtmr_reset);
+    device_class_set_props(dc, bcm2835_armtmr_properties);
+    dc->vmsd = &bcm2835_armtmr_vmstate;
+}
+
+static const TypeInfo bcm2835_armtmr_info = {
+    .name = TYPE_BCM2835_ARMTMR,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(BCM2835ArmTimerState),
+    .instance_init = bcm2835_armtmr_init,
+    .class_init = bcm2835_armtmr_class_init,
+};
+
+static void bcm2835_armtmr_register_types(void)
+{
+    type_register_static(&bcm2835_armtmr_info);
+}
+
+type_init(bcm2835_armtmr_register_types);
