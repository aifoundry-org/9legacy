From 0c8998c04816c770c54a9443c917fd599f0e4a34 Mon Sep 17 00:00:00 2001
From: Shelley <shelley@exe.dev>
Date: Tue, 10 Nov 2026 22:41:59 +0000
Subject: [PATCH] hw/usb/hcd-dwc2: count zero-length packets in HCTSIZ.PKTCNT

A transfer that ended with a zero-length packet left PKTCNT as it
was, as only the bytes transferred were counted; the hardware
counts each packet, and a zero-length IN packet ends the transfer
like any short one.  A driver that checks PKTCNT to learn whether
a packet arrived, as Plan 9's does, waited for one forever after
a zero-length status stage or bulk read.

Co-authored-by: Shelley <shelley@exe.dev>
---
 hw/usb/hcd-dwc2.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hw/usb/hcd-dwc2.c b/hw/usb/hcd-dwc2.c
index fd18673..3e8dbfe 100644
--- a/hw/usb/hcd-dwc2.c
+++ b/hw/usb/hcd-dwc2.c
@@ -336,7 +336,8 @@ babble:
         }
 
         tpcnt = actual / mps;
-        if (actual % mps) {
+        /* a zero-length packet is a short packet too */
+        if (actual % mps || actual == 0) {
             tpcnt++;
             if (pid == USB_TOKEN_IN) {
                 done = true;
