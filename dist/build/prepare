#!/bin/rc

rfork n

. funcs

cat > /sys/lib/dist/setup << EOF
#!/bin/rc
# setup - prep for the mkfile
. ./defs

bind $build/sources /n/sources
bind $build/other /n/other
bind $build/dist /n/dist
EOF

sed /'mk cddisk'/d /sys/lib/dist/mkfile > /sys/lib/dist/mkfile.new
mv /sys/lib/dist/mkfile.new /sys/lib/dist/mkfile

rm -rf $build
mkdir $build
chmod +t $build

if(test -d /usr/web)
	rm -f /usr/web/plan9checksums.txt
if not
	mkdir /usr/web
chmod +t /usr/web

mkdir $build/dist
mkdir $build/other
mkdir $build/other/dist
mkdir $build/sources
mkdir $build/sources/plan9
rm -rf /sys/lib/dist/web.protect
mkdir /sys/lib/dist/web.protect
chmod +t /sys/lib/dist/web.protect
